# MongoDB connection string (MongoDB Atlas free tier works). Used for all persistence.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/interview-prep-kit

# Secret used to sign JWT session cookies. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Groq API key (free tier: https://console.groq.com/keys). Used for all LLM generation calls.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for generation. openai/gpt-oss-120b is available on Groq's free tier with JSON mode support (llama-3.3-70b-versatile was retired).
GROQ_MODEL=openai/gpt-oss-120b

# "production" enforces SSRF protection (rejects private/loopback company URLs).
# "development" or "test" allows localhost/private URLs so the batch entry point can be run
# against locally-served fixture company sites, as the brief requires.
NODE_ENV=development

# Optional: cap on pages fetched per company crawl (defaults to 8 if unset).
CRAWL_MAX_PAGES=8

# Optional: HTTP timeout per fetch in ms (defaults to 8000 if unset).
FETCH_TIMEOUT_MS=8000
